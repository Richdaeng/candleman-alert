# 캔들맨 알림 설정 예시 — 진짜 값은 .env 에 넣어요 (python -m candleman setup 이 대신 만들어 줌)
# .env 는 .gitignore 에 들어 있어 저장소에 올라가지 않아요.

# 바이낸스: '읽기(Enable Reading)'만 켠 API 키
BINANCE_API_KEY=여기에_API_Key
BINANCE_API_SECRET=여기에_Secret_Key

# 디스코드 웹후크 (채널 설정 → 연동 → 웹후크 → 웹후크 URL 복사)
DISCORD_WEBHOOK_TRADE=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_SUMMARY=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_STATUS=https://discord.com/api/webhooks/...
# (선택) 처음 진입한 종목을 #종목설명에 소개 — 비워 두면 안 씀
DISCORD_WEBHOOK_SYMBOLS=https://discord.com/api/webhooks/...
# (선택) 포지션이 바뀔 때마다 #현재포지션에 지금 포지션 카드 — 비워 두면 안 씀
DISCORD_WEBHOOK_POSITIONS=https://discord.com/api/webhooks/...
# (선택) 매일 아침 #일일-경제-브리핑 — 비워 두면 안 씀 (시각: BRIEFING_HOUR, 기본 8)
DISCORD_WEBHOOK_BRIEFING=https://discord.com/api/webhooks/...
# BRIEFING_HOUR=8
# (선택) /일지(운영자 전용)를 남길 #매매일지 — 모두 볼 수 있고 글은 운영자만 쓰는 채널 · 비워 두면 #봇-상태에 남김
DISCORD_WEBHOOK_JOURNAL=https://discord.com/api/webhooks/...

# (선택) #잡담방의 /포지션 명령 봇 — python -m candleman bot 으로 넣는 게 편함
# DISCORD_BOT_TOKEN=여기에_봇_토큰
# DISCORD_COMMAND_CHANNEL=잡담방
# (선택) 봇의 커뮤니티 기능 — #규칙 입장 버튼 · 레벨(/레벨 · /순위) · 도배 처리 (기본: 켬 · 0 이면 끔)
# COMMUNITY=0
# (선택) 글마다 @everyone 으로 울리는 채널 (기본: trade,positions,summary,briefing · symbols · journal 도 가능 · 0 이면 끔)
# PING_EVERYONE=trade,positions,summary,briefing

# 매일 요약 시각 (한국 시간, 0~23)
SUMMARY_HOUR=22

# (선택) 주인장 수익률의 시작 금액(달러)과 그 금액이 기준인 해 — 포지션을 끝낼 때 #실시간-매매에 '시작 · 현재 · 수익률'을 붙이고
# #잡담방의 /주인장수익률로도 보임. 비워 두면 2026년 7800, 0 이면 끔. 다음 해부터는 1월 1일 0시의 바이낸스 전체 자산이 기준.
# 입금 · 출금을 하면 그해 기준으로 고쳐 주세요.
# START_USD=7800
# START_YEAR=2026

# (선택) 현물 체결 알림 · #현재포지션의 현물 보유 (기본: 켬)
# SPOT=0

# (선택) 자동 업데이트 — 매일 이 시각에 GitHub 의 stable 판을 확인 (기본: 켬 · 05시)
# AUTO_UPDATE=0
# UPDATE_HOUR=5
